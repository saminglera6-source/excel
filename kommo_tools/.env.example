# Copiá este archivo a ".env" (sin ".example") y completá los valores reales.
# El archivo ".env" NUNCA se sube a git (ver .gitignore) — ahí van tus claves.

# Subdominio de tu cuenta Kommo. Si entrás a lolaso.kommo.com, es "lolaso".
KOMMO_SUBDOMINIO=lolaso

# Token de acceso de larga duración de una integración PRIVADA de Kommo.
# Se genera en: Ajustes -> Integraciones -> Crear integración -> Privada ->
# pestaña "Claves y accesos" -> "Token de acceso" (elegí la opción de token
# de larga duración, dura ~1 año). Ver README.md para el paso a paso.
KOMMO_TOKEN=

# Nombre exacto del pipeline a usar (tal cual aparece en Kommo).
KOMMO_PIPELINE=Embudo de ventas

# Clave de API de Anthropic (Claude), para clasificar el contenido de cada
# chat. Se genera en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
